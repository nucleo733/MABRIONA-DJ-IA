{
  "name": "matoko-dj",
  "productName": "MATOKO DJ",
  "version": "0.3.0",
  "description": "MATOKO DJ — app de escritorio del mezclador de MABRIONA — motor real (Electron) con su propio código del mezclador, standalone, sin cargar mabriona.com.",
  "main": "main.js",
  "author": "Wber733",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "npm --prefix renderer run build",
    "start": "npm run build:renderer && electron .",
    "dist:mac": "npm run build:renderer && electron-builder --mac dir",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --publish=never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.matoko.dj",
    "productName": "MATOKO DJ",
    "icon": "build/icon.icns",
    "files": ["main.js", "preload.js", "braveInstaller.js", "renderer/dist/**/*"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [{ "target": "dir", "arch": ["x64", "arm64"] }]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "include": "installer/checkBrave.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [{ "target": "AppImage", "arch": ["x64"] }]
    },
    "directories": {
      "output": "dist"
    }
  }
}
