{
  "name": "matoko-dj",
  "productName": "MATOKO DJ",
  "version": "0.3.2",
  "description": "MATOKO DJ — app de escritorio del mezclador de MABRIONA — motor real (Electron) con su propio código del mezclador, standalone, sin cargar mabriona.com.",
  "main": "main.js",
  "author": "Wber733",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:renderer": "npm --prefix renderer run build",
    "start": "npm run build:renderer && electron .",
    "dist:mac": "npm run build:renderer && electron-builder --mac dir",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --publish=never",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "playwright": "^1.61.1"
  },
  "build": {
    "appId": "com.matoko.dj",
    "productName": "MATOKO DJ",
    "icon": "build/icon.icns",
    "files": [
      "main.js",
      "preload.js",
      "braveInstaller.js",
      "stemSeparation.js",
      "stemWorker.js",
      "renderer/dist/**/*",
      "node_modules/onnxruntime-node/dist/**/*",
      "node_modules/onnxruntime-node/lib/**/*",
      "node_modules/onnxruntime-node/bin/**/*",
      "node_modules/onnxruntime-node/package.json",
      "node_modules/onnxruntime-common/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/Brave-Browser-universal.pkg",
          "to": "brave/Brave-Browser-universal.pkg"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "installer/checkBrave.nsh"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "vendor/brave-browser.deb",
          "to": "brave/brave-browser.deb"
        },
        {
          "from": "vendor/brave-browser.rpm",
          "to": "brave/brave-browser.rpm"
        }
      ]
    },
    "directories": {
      "output": "dist"
    },
    "deb": {
      "afterInstall": "installer/linuxAfterInstall.sh"
    },
    "rpm": {
      "afterInstall": "installer/linuxAfterInstall.sh"
    },
    "beforePack": "scripts/fetchBrave.js"
  },
  "dependencies": {
    "onnxruntime-node": "1.23.0"
  }
}
